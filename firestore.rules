rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Global projects: shared history (only server writes)
    match /global_projects/{projectId} {
      allow read: if true;
      allow write: if false; // Reserved for Admin SDK
    }

    // User profiles and private projects
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      
      match /projects/{projectId} {
        allow list, get, create, update, delete: if isOwner(userId);
      }
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
