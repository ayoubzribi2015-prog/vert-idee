rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'lastLoginAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && data.photoURL is string && data.photoURL.size() <= 2048;
    }

    function isValidProjectAudit(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'sector', 'description', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.sector is string && data.sector.size() <= 128
        && data.description is string && data.description.size() <= 5000
        && data.createdAt is string // In this app, timestamps are currently stored as ISO strings
        && data.updatedAt is string;
    }

    // --- Collection Match Blocks ---

    // Global projects: shared history (only server writes)
    match /global_projects/{projectId} {
      allow read: if true;
      allow write: if false; // Reserved for Admin SDK
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      
      // User's private projects
      match /projects/{projectId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProjectAudit(incoming());
        allow update: if isOwner(userId) && isValidProjectAudit(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'sector', 'location', 'updatedAt', 'projectSynthesis', 'environmentalAspects', 'socialAspects', 'greenEntrepreneurshipIntegration', 'sdgAlignment', 'impactIndicators', 'greenFinancingAndLabels', 'priorityActionPlan'])
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
